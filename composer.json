{
    "name": "secretwebmaster/wncms-tags",
    "description": "Add tags and taggable behaviour to your Wncms",
    "keywords": [
        "secretwebmaster",
        "wncms",
        "wncms-tags"
    ],
    "homepage": "https://github.com/secretwebmaster/wncms-tags",
    "license": "MIT",
    "authors": [
        {
            "name": "文尼先生",
            "email": "earnbyshare2016@gmail.com",
            "homepage": "https://wntheme.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
        "nesbot/carbon": "^2.63|^3.0",
        "secretwebmaster/wncms-translatable": "^1.3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Wncms\\Tags\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wncms\\Tags\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wncms\\Tags\\TagsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.7.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
